{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-recorder-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "env": {
    "staging": {
      "preview_urls": false,
      "vars": {
        "SUPABASE_URL": "https://opgxiqbezqzwmqbdumac.supabase.co",
        "R2_ACCOUNT_ID": "a712b19a210fbbaa8dd78678c1fa8f73",
        "R2_BUCKET_NAME": "ai-recorder-original-audio"
      },
      "r2_buckets": [
        {
          "binding": "ORIGINAL_AUDIO",
          "bucket_name": "ai-recorder-original-audio"
        }
      ]
    }
  }
}
